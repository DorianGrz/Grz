{{ 'lk.css' | asset_url | stylesheet_tag }}
<footer class="lk-root lk-footer" id="lk-{{ section.id }}">
  <div class="lk-wrap lk-footer__inner">
    <a href="{{ routes.root_url }}" class="lk-footer__brand">
      <svg width="22" height="30" viewBox="0 0 22 30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M11 29V2M11 24l-7-5M11 24l7-5M11 18l-6-4.5M11 18l6-4.5M11 12.5l-4.5-3.5M11 12.5l4.5-3.5M11 7.5l-3-2.5M11 7.5l3-2.5"/></svg>
      <span>{{ shop.name }}</span>
    </a>
    {%- if section.settings.tagline != blank -%}
      <p class="lk-footer__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}
    <nav class="lk-footer__nav" aria-label="Informacje">
      <a href="/pages/dostawa-i-zwroty">Dostawa i zwroty</a>
      <a href="/pages/regulamin">Regulamin</a>
      <a href="/pages/polityka-prywatnosci">Polityka prywatności</a>
      <a href="/pages/kontakt">Kontakt</a>
    </nav>
    {%- if section.settings.email != blank -%}
      <a class="lk-footer__mail" href="mailto:{{ section.settings.email }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        {{ section.settings.email }}
      </a>
    {%- endif -%}
    <div class="lk-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
  </div>
</footer>
<script>
  (function () {
    if (window.lkReveal) return;
    window.lkReveal = true;
    if (!('IntersectionObserver' in window) || (window.Shopify && Shopify.designMode)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('.lk-root.lk-sec').forEach(function (sec) {
      if (sec.getBoundingClientRect().top < window.innerHeight) return;
      sec.classList.add('lk-rv');
      io.observe(sec);
    });
  })();
</script>
{% schema %}
{
  "name": "LK Stopka",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Hasło", "default": "Świąteczne dekoracje, które wyglądają jak prawdziwe." },
    { "type": "text", "id": "email", "label": "E-mail", "default": "kontakt@lesnykominek.pl" }
  ]
}
{% endschema %}
