{{ 'lk.css' | asset_url | stylesheet_tag }}
<section class="lk-root lk-sec" id="lk-{{ section.id }}">
  <div class="lk-wrap lk-narrow">
    <h2 class="lk-h2">{{ section.settings.heading }}</h2>
    <table class="lk-cmp">
      <thead>
        <tr>
          <th scope="col"><span class="lk-sr">Cecha</span></th>
          <th scope="col">{{ section.settings.col_1 }}</th>
          <th scope="col">{{ section.settings.col_2 }}</th>
          <th scope="col" class="lk-cmp__us">{{ section.settings.col_3 }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.label }}</th>
            <td>{{ block.settings.v1 }}</td>
            <td>{{ block.settings.v2 }}</td>
            <td class="lk-cmp__us">{{ block.settings.v3 }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>
{% schema %}
{
  "name": "LK Porównanie",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Dlaczego nie żywe gałązki?" },
    { "type": "text", "id": "col_1", "label": "Kolumna 1", "default": "Żywe gałązki" },
    { "type": "text", "id": "col_2", "label": "Kolumna 2", "default": "Girlanda z marketu" },
    { "type": "text", "id": "col_3", "label": "Kolumna 3", "default": "Girlanda Cedrowa" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Wiersz",
      "settings": [
        { "type": "text", "id": "label", "label": "Cecha", "default": "Cecha" },
        { "type": "html", "id": "v1", "label": "Kolumna 1", "default": "<span class=\"lk-no\">✕</span>" },
        { "type": "html", "id": "v2", "label": "Kolumna 2", "default": "<span class=\"lk-no\">✕</span>" },
        { "type": "html", "id": "v3", "label": "Kolumna 3", "default": "<span class=\"lk-yes\">✓</span>" }
      ]
    }
  ]
}
{% endschema %}
