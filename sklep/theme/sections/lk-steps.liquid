{{ 'lk.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
-%}
<section class="lk-root lk-sec" id="lk-{{ section.id }}">
  <div class="lk-wrap">
    <h2 class="lk-h2">{{ section.settings.heading }}</h2>
    <div class="lk-steps">
      {%- for block in section.blocks -%}
        <div class="lk-step" {{ block.shopify_attributes }}>
          <div class="lk-step__img">{% render 'lk-img', image: block.settings.image, p: p, idx: block.settings.media_index, sizes: '(min-width: 750px) 33vw, 100vw' %}</div>
          <div class="lk-step__body">
            <span class="lk-step__num">{{ forloop.index }}</span>
            <h3 class="lk-h3">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LK Jak to działa",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (strona główna)" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Jak to działa" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Krok",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Obraz" },
        { "type": "number", "id": "media_index", "label": "Zdjęcie produktu nr (bez obrazu)", "default": 1 },
        { "type": "text", "id": "title", "label": "Tytuł", "default": "Krok" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Opis kroku" }
      ]
    }
  ]
}
{% endschema %}
