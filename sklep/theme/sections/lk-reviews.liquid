{{ 'lk.css' | asset_url | stylesheet_tag }}
{%- comment -%} Sekcja pokazuje się dopiero, gdy dodasz co najmniej jedną prawdziwą opinię klienta. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="lk-root lk-sec lk-sec--alt" id="lk-{{ section.id }}">
  <div class="lk-wrap">
    <h2 class="lk-h2">{{ section.settings.heading }}</h2>
    <div class="lk-reviews">
      {%- for block in section.blocks -%}
        <blockquote class="lk-review" {{ block.shopify_attributes }}>
          <div class="lk-review__stars" aria-label="{{ block.settings.stars }} na 5">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
          <p>{{ block.settings.text }}</p>
          <div class="lk-review__who">{{ block.settings.author }}</div>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "LK Opinie",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Co mówią klienci" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Opinia klienta",
      "settings": [
        { "type": "range", "id": "stars", "label": "Gwiazdki", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Treść", "default": "Treść opinii" },
        { "type": "text", "id": "author", "label": "Autor", "default": "Imię, miasto" }
      ]
    }
  ]
}
{% endschema %}
