{{ 'lk.css' | asset_url | stylesheet_tag }}
<section class="lk-root lk-sec lk-safe-sec" id="lk-{{ section.id }}">
  <div class="lk-wrap lk-narrow">
    <div class="lk-safe">
      <div class="lk-safe__head">
        <span class="lk-safe__ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M12 8v5"/><path d="M12 16.5h.01"/></svg></span>
        <h2 class="lk-safe__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <div class="lk-safe__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
      <ul class="lk-safe__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.producer != blank -%}
        <div class="lk-safe__meta">{{ section.settings.producer }}</div>
      {%- endif -%}
      {%- if section.settings.contact != blank -%}
        <div class="lk-safe__meta">{{ section.settings.contact }}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LK Bezpieczeństwo",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Bezpieczeństwo produktu" },
    { "type": "richtext", "id": "intro", "label": "Opis produktu", "default": "<p>Girlanda Cedrowa: sztuczna girlanda dekoracyjna z tworzywa sztucznego, długość 1,5 m.</p>" },
    { "type": "richtext", "id": "producer", "label": "Producent i podmiot w UE" },
    { "type": "richtext", "id": "contact", "label": "Kontakt", "default": "<p>Pytania o bezpieczeństwo produktu: <a href=\"mailto:kontakt@lesnykominek.pl\">kontakt@lesnykominek.pl</a></p>" }
  ],
  "blocks": [
    {
      "type": "warning",
      "name": "Ostrzeżenie",
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst", "default": "Treść ostrzeżenia." }
      ]
    }
  ]
}
{% endschema %}
