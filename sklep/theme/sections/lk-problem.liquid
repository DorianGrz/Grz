{{ 'lk.css' | asset_url | stylesheet_tag }}
<section class="lk-root lk-sec lk-sec--alt lk-problem" id="lk-{{ section.id }}">
  <div class="lk-wrap lk-narrow lk-center">
    <div class="lk-problem__mark" aria-hidden="true">“</div>
    <blockquote class="lk-problem__quote">{{ section.settings.quote }}</blockquote>
    <div class="lk-problem__sep" aria-hidden="true">
      <svg width="18" height="24" viewBox="0 0 22 30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M11 29V2M11 24l-7-5M11 24l7-5M11 18l-6-4.5M11 18l6-4.5M11 12.5l-4.5-3.5M11 12.5l4.5-3.5M11 7.5l-3-2.5M11 7.5l3-2.5"/></svg>
    </div>
    <div class="lk-problem__text">{{ section.settings.text }}</div>
    {%- if section.settings.solution != blank -%}
      <p class="lk-problem__solution">{{ section.settings.solution }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "LK Problem",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Zdanie główne", "default": "Co roku obiecujesz sobie, że w te święta dom będzie wyglądał jak z Pinteresta, a kończy się na łańcuchu lampek z marketu." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Żywe gałązki usychają w ciepłym mieszkaniu i sypią igłami po podłodze. Tanie girlandy z marketu są rzadkie i płaskie, więc kominek dalej wygląda pusto.</p>" },
    { "type": "text", "id": "solution", "label": "Rozwiązanie (wyróżnione)", "default": "Girlanda Cedrowa jest gęsta jak prawdziwa i wystarczy ją rozłożyć." }
  ]
}
{% endschema %}
