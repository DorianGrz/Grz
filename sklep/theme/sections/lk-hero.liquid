{{ 'lk.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
  assign sv = p.selected_or_first_available_variant
  assign first_price = p.variants.first.price
  assign two_first = first_price | times: 2
-%}
<section class="lk-root lk-hero" id="lk-{{ section.id }}" data-lk-hero>
  {%- if section.settings.topbar != blank -%}
    <div class="lk-topbar">{{ section.settings.topbar }}</div>
  {%- endif -%}
  <div class="lk-brand">
    <a href="{{ routes.root_url }}" class="lk-brand__name" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: height: 34, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
  </div>

  {%- if p != blank -%}
  <div class="lk-wrap lk-hero__grid">
    <div class="lk-gallery">
      <div class="lk-gallery__track" data-lk-track>
        {%- for m in p.media -%}
          <div class="lk-gallery__slide" data-media-id="{{ m.id }}">
            {%- if forloop.first -%}
              {{ m.preview_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 560px, 88vw', loading: 'eager', fetchpriority: 'high', alt: m.alt }}
            {%- else -%}
              {{ m.preview_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 560px, 88vw', loading: 'lazy', alt: m.alt }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if p.media.size > 1 -%}
        <div class="lk-dots" data-lk-dots>
          {%- for m in p.media -%}
            <button type="button" aria-label="Zdjęcie {{ forloop.index }}" data-index="{{ forloop.index0 }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="lk-buy">
      <h1 class="lk-h1">{{ section.settings.heading }}</h1>

      {%- form 'product', p, id: 'lk-buy-form', class: 'lk-form', novalidate: 'novalidate' -%}
        <fieldset class="lk-opts">
          <legend class="lk-sr">Wybierz zestaw</legend>
          {%- for v in p.variants -%}
            {%- liquid
              if forloop.index == 1
                assign meters = section.settings.meters_1
              else
                assign meters = section.settings.meters_2
              endif
              assign per_m = v.price | divided_by: meters
              assign save = two_first | minus: v.price
            -%}
            <label class="lk-opt">
              <input
                type="radio"
                name="id"
                value="{{ v.id }}"
                {% if v.id == sv.id %}checked{% endif %}
                {% unless v.available %}disabled{% endunless %}
                data-price="{{ v.price | money | escape }}"
                data-title="{{ v.title | escape }}"
                data-media="{% if v.featured_media %}{{ v.featured_media.id }}{% endif %}"
              >
              <span class="lk-opt__body">
                {%- if forloop.index == section.settings.badge_index and section.settings.badge != blank -%}
                  <span class="lk-opt__badge">{{ section.settings.badge }}</span>
                {%- endif -%}
                <span class="lk-opt__name">{{ v.title | split: ':' | first }}</span>
                <span class="lk-opt__meta">{{ v.title | split: ': ' | last }} ({{ meters }} m)</span>
                <span class="lk-opt__price">{{ v.price | money }}</span>
                <span class="lk-opt__meta">{{ per_m | money }} za metr</span>
                {%- if forloop.index > 1 and save > 0 -%}
                  <span class="lk-opt__save">{{ save | money }} taniej niż 2 × {{ p.variants.first.title | split: ':' | first }}</span>
                {%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="lk-btn" data-lk-atc>
          {{ section.settings.button }} <span aria-hidden="true">·</span> <span data-lk-price>{{ sv.price | money }}</span>
        </button>
      {%- endform -%}

      {%- if section.settings.eta_text != blank -%}
        <p class="lk-eta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>
          <span>{{ section.settings.eta_text }}</span>
        </p>
      {%- endif -%}

      <ul class="lk-trust">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign t = section.settings.trust_1
              when 2
                assign t = section.settings.trust_2
              when 3
                assign t = section.settings.trust_3
            endcase
          -%}
          {%- if t != blank -%}
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>{{ t }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="lk-buy__after lk-lead">{{ section.settings.subheading }}</div>
    </div>
  </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('lk-{{ section.id }}');
    if (!root || root.dataset.lkInit) return;
    root.dataset.lkInit = '1';
    var track = root.querySelector('[data-lk-track]');
    var dots = root.querySelectorAll('[data-lk-dots] button');

    function goTo(slide) {
      if (!slide || !track) return;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft - (track.clientWidth - slide.clientWidth) / 2, behavior: 'smooth' });
    }

    document.addEventListener('change', function (e) {
      var input = e.target.closest('#lk-{{ section.id }} input[name="id"]');
      if (!input) return;
      root.querySelectorAll('[data-lk-price]').forEach(function (el) { el.textContent = input.dataset.price; });
      document.dispatchEvent(new CustomEvent('lk:variant', { detail: { title: input.dataset.title, price: input.dataset.price } }));
      if (input.dataset.media) goTo(track.querySelector('[data-media-id="' + input.dataset.media + '"]'));
    });

    document.addEventListener('click', function (e) {
      var dot = e.target.closest('#lk-{{ section.id }} [data-lk-dots] button');
      if (!dot) return;
      goTo(track.children[Number(dot.dataset.index)]);
    });

    if (track && dots.length && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          var idx = Array.prototype.indexOf.call(track.children, en.target);
          dots.forEach(function (d, i) { d.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
        });
      }, { root: track, threshold: 0.6 });
      Array.prototype.forEach.call(track.children, function (s) { io.observe(s); });
    }
  })();
</script>

{% schema %}
{
  "name": "LK Hero",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (strona główna)" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "topbar", "label": "Pasek na górze", "default": "Darmowa dostawa i 30 dni na zwrot" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Gęsta girlanda cedrowa, która wygląda jak prawdziwa" },
    { "type": "richtext", "id": "subheading", "label": "Opis pod przyciskiem", "default": "<p>Powieś ją na kominku, poręczy albo nad drzwiami. Nie gubi igieł, nie usycha i wyciągniesz ją znowu za rok.</p>" },
    { "type": "text", "id": "button", "label": "Tekst przycisku", "default": "Dodaj do koszyka" },
    { "type": "number", "id": "meters_1", "label": "Metry w wariancie 1", "default": 3 },
    { "type": "number", "id": "meters_2", "label": "Metry w wariancie 2", "default": 6 },
    { "type": "text", "id": "badge", "label": "Plakietka", "default": "Najniższa cena za metr" },
    { "type": "number", "id": "badge_index", "label": "Plakietka przy wariancie", "default": 2 },
    { "type": "text", "id": "eta_text", "label": "Czas dostawy", "default": "Wysyłka 1 do 3 dni, dostawa 3 do 5 dni." },
    { "type": "text", "id": "trust_1", "label": "Zaleta 1", "default": "Darmowa dostawa do całej Polski" },
    { "type": "text", "id": "trust_2", "label": "Zaleta 2", "default": "30 dni na zwrot bez podawania przyczyny" },
    { "type": "text", "id": "trust_3", "label": "Zaleta 3", "default": "Bezpieczna płatność w kasie Shopify" }
  ]
}
{% endschema %}
