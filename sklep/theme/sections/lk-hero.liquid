{{ 'lk.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
  assign sv = p.selected_or_first_available_variant
  assign first_price = p.variants.first.price
  assign two_first = first_price | times: 2
-%}
<section class="lk-root lk-hero" id="lk-{{ section.id }}" data-lk-hero>
  {%- if section.settings.topbar_1 != blank or section.settings.topbar_2 != blank -%}
    <div class="lk-topbar">
      {%- if section.settings.topbar_1 != blank -%}
        <span class="lk-topbar__item"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>{{ section.settings.topbar_1 }}</span>
      {%- endif -%}
      {%- if section.settings.topbar_1 != blank and section.settings.topbar_2 != blank -%}
        <span class="lk-topbar__dot" aria-hidden="true"></span>
      {%- endif -%}
      {%- if section.settings.topbar_2 != blank -%}
        <span class="lk-topbar__item"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4h4"/></svg>{{ section.settings.topbar_2 }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="lk-brand">
    <a href="{{ routes.root_url }}" class="lk-brand__name" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: height: 34, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
  </div>

  {%- if p != blank -%}
  <div class="lk-wrap lk-hero__grid">
    <div class="lk-gallery">
      <div class="lk-gallery__track" data-lk-track>
        {%- for m in p.media -%}
          <div class="lk-gallery__slide" data-media-id="{{ m.id }}">
            {%- if forloop.first -%}
              {{ m.preview_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 560px, 86vw', loading: 'eager', fetchpriority: 'high', alt: m.alt }}
            {%- else -%}
              {{ m.preview_image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 560px, 86vw', loading: 'lazy', decoding: 'async', alt: m.alt }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if p.media.size > 1 -%}
        <button type="button" class="lk-gal-nav lk-gal-nav--prev" data-lk-prev aria-label="Poprzednie zdjęcie" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="lk-gal-nav lk-gal-nav--next" data-lk-next aria-label="Następne zdjęcie"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        <div class="lk-dots" data-lk-dots>
          {%- for m in p.media -%}
            <button type="button" aria-label="Zdjęcie {{ forloop.index }}" data-index="{{ forloop.index0 }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="lk-buy">
      <h1 class="lk-h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="lk-sub">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- form 'product', p, id: 'lk-buy-form', class: 'lk-form', novalidate: 'novalidate' -%}
        <fieldset class="lk-opts">
          <legend class="lk-sr">Wybierz zestaw</legend>
          {%- for v in p.variants -%}
            {%- liquid
              if forloop.index == 1
                assign meters = section.settings.meters_1
              else
                assign meters = section.settings.meters_2
              endif
              assign per_m = v.price | divided_by: meters
              assign save = two_first | minus: v.price
            -%}
            <label class="lk-opt">
              <input
                type="radio"
                name="id"
                value="{{ v.id }}"
                {% if v.id == sv.id %}checked{% endif %}
                {% unless v.available %}disabled{% endunless %}
                data-price="{{ v.price | money | escape }}"
                data-title="{{ v.title | escape }}"
                data-media="{% if v.featured_media %}{{ v.featured_media.id }}{% endif %}"
              >
              <span class="lk-opt__body">
                {%- if forloop.index == section.settings.badge_index and section.settings.badge != blank -%}
                  <span class="lk-opt__badge">{{ section.settings.badge }}</span>
                {%- endif -%}
                <span class="lk-opt__radio" aria-hidden="true"></span>
                <span class="lk-opt__main">
                  <span class="lk-opt__name">{{ v.title | split: ':' | first }}</span>
                  <span class="lk-opt__meta">{{ v.title | split: ': ' | last }}, razem {{ meters }} m</span>
                </span>
                <span class="lk-opt__side">
                  <span class="lk-opt__price">{{ v.price | money }}</span>
                  <span class="lk-opt__meta">{{ per_m | money }} / m</span>
                </span>
                {%- if forloop.index > 1 and save > 0 -%}
                  <span class="lk-opt__break" aria-hidden="true"></span>
                  <span class="lk-opt__save">{{ save | money_without_trailing_zeros }} taniej niż 2 × {{ p.variants.first.title | split: ':' | first }}</span>
                {%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="lk-btn" data-lk-atc>
          {{ section.settings.button }} <span aria-hidden="true">·</span> <span data-lk-price>{{ sv.price | money }}</span>
        </button>
      {%- endform -%}

      {%- if section.settings.eta_ship != blank and section.settings.eta_delivery != blank -%}
        <div class="lk-eta" role="group" aria-label="Czas dostawy">
          <div class="lk-eta__step">
            <span class="lk-eta__ico"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span>
            <span class="lk-eta__txt"><b>Wysyłka</b>{{ section.settings.eta_ship }}</span>
          </div>
          <span class="lk-eta__line" aria-hidden="true"></span>
          <div class="lk-eta__step">
            <span class="lk-eta__ico"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/></svg></span>
            <span class="lk-eta__txt"><b>Dostawa</b>{{ section.settings.eta_delivery }}</span>
          </div>
        </div>
      {%- endif -%}

      <ul class="lk-perks">
        {%- if section.settings.perk_1_title != blank -%}
          <li class="lk-perk">
            <span class="lk-perk__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg></span>
            <strong>{{ section.settings.perk_1_title }}</strong>
            <span>{{ section.settings.perk_1_text }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.perk_2_title != blank -%}
          <li class="lk-perk">
            <span class="lk-perk__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4h4"/></svg></span>
            <strong>{{ section.settings.perk_2_title }}</strong>
            <span>{{ section.settings.perk_2_text }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.perk_3_title != blank -%}
          <li class="lk-perk">
            <span class="lk-perk__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
            <strong>{{ section.settings.perk_3_title }}</strong>
            <span>{{ section.settings.perk_3_text }}</span>
          </li>
        {%- endif -%}
      </ul>

    </div>
  </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('lk-{{ section.id }}');
    if (!root || root.dataset.lkInit) return;
    root.dataset.lkInit = '1';
    var track = root.querySelector('[data-lk-track]');
    var dots = root.querySelectorAll('[data-lk-dots] button');

    function goTo(slide) {
      if (!slide || !track) return;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft - (track.clientWidth - slide.clientWidth) / 2, behavior: 'smooth' });
    }

    document.addEventListener('change', function (e) {
      var input = e.target.closest('#lk-{{ section.id }} input[name="id"]');
      if (!input) return;
      root.querySelectorAll('[data-lk-price]').forEach(function (el) { el.textContent = input.dataset.price; });
      document.dispatchEvent(new CustomEvent('lk:variant', { detail: { title: input.dataset.title, price: input.dataset.price } }));
      if (input.dataset.media) goTo(track.querySelector('[data-media-id="' + input.dataset.media + '"]'));
    });

    var current = 0;
    var prev = root.querySelector('[data-lk-prev]');
    var next = root.querySelector('[data-lk-next]');
    function setCurrent(idx) {
      current = idx;
      dots.forEach(function (d, i) { d.setAttribute('aria-current', i === idx ? 'true' : 'false'); });
      if (prev) prev.disabled = idx <= 0;
      if (next) next.disabled = idx >= track.children.length - 1;
    }

    document.addEventListener('click', function (e) {
      var dot = e.target.closest('#lk-{{ section.id }} [data-lk-dots] button');
      if (dot) { goTo(track.children[Number(dot.dataset.index)]); return; }
      if (e.target.closest('#lk-{{ section.id }} [data-lk-prev]')) { goTo(track.children[current - 1]); return; }
      if (e.target.closest('#lk-{{ section.id }} [data-lk-next]')) { goTo(track.children[current + 1]); }
    });

    if (track && dots.length && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          setCurrent(Array.prototype.indexOf.call(track.children, en.target));
        });
      }, { root: track, threshold: 0.6 });
      Array.prototype.forEach.call(track.children, function (s) { io.observe(s); });
    }
  })();
</script>

{% schema %}
{
  "name": "LK Hero",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (strona główna)" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "topbar_1", "label": "Pasek na górze: tekst 1", "default": "Darmowa dostawa" },
    { "type": "text", "id": "topbar_2", "label": "Pasek na górze: tekst 2", "default": "30 dni na zwrot" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Gęsta girlanda cedrowa, która wygląda jak prawdziwa" },
    { "type": "richtext", "id": "subheading", "label": "Opis pod nagłówkiem", "default": "<p>Powieś ją na kominku, poręczy albo nad drzwiami. Nie gubi igieł, nie usycha i wyciągniesz ją znowu za rok.</p>" },
    { "type": "text", "id": "button", "label": "Tekst przycisku", "default": "Dodaj do koszyka" },
    { "type": "number", "id": "meters_1", "label": "Metry w wariancie 1", "default": 3 },
    { "type": "number", "id": "meters_2", "label": "Metry w wariancie 2", "default": 6 },
    { "type": "text", "id": "badge", "label": "Plakietka", "default": "Najniższa cena za metr" },
    { "type": "number", "id": "badge_index", "label": "Plakietka przy wariancie", "default": 2 },
    { "type": "text", "id": "eta_ship", "label": "Czas wysyłki", "default": "1 do 3 dni" },
    { "type": "text", "id": "eta_delivery", "label": "Czas dostawy", "default": "3 do 5 dni" },
    { "type": "text", "id": "perk_1_title", "label": "Zaleta 1: tytuł", "default": "Darmowa dostawa" },
    { "type": "text", "id": "perk_1_text", "label": "Zaleta 1: opis", "default": "do całej Polski" },
    { "type": "text", "id": "perk_2_title", "label": "Zaleta 2: tytuł", "default": "30 dni na zwrot" },
    { "type": "text", "id": "perk_2_text", "label": "Zaleta 2: opis", "default": "bez podawania przyczyny" },
    { "type": "text", "id": "perk_3_title", "label": "Zaleta 3: tytuł", "default": "Bezpieczna płatność" },
    { "type": "text", "id": "perk_3_text", "label": "Zaleta 3: opis", "default": "szyfrowane połączenie" }
  ]
}
{% endschema %}
