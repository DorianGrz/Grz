{{ 'lk.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
-%}
<section class="lk-root lk-sec lk-sec--alt" id="lk-{{ section.id }}">
  <div class="lk-wrap">
    <h2 class="lk-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="lk-box__sub lk-center lk-lead">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="lk-box">
      {%- if section.settings.image_desktop != blank -%}
        <div class="lk-box__img lk-only-m">{% render 'lk-img', image: section.settings.image, p: p, idx: section.settings.media_index, sizes: '100vw' %}</div>
        <div class="lk-box__img lk-only-d">{% render 'lk-img', image: section.settings.image_desktop, sizes: '50vw' %}</div>
      {%- else -%}
        <div class="lk-box__img">{% render 'lk-img', image: section.settings.image, p: p, idx: section.settings.media_index, sizes: '(min-width: 750px) 50vw, 100vw' %}</div>
      {%- endif -%}
      <div class="lk-box__body">
        <div class="lk-sets">
          {%- for block in section.blocks -%}
            {%- if block.type == 'set' -%}
              <div class="lk-set" {{ block.shopify_attributes }}>
                <div class="lk-set__bars" aria-hidden="true">{% for i in (1..block.settings.count) %}<span></span>{% endfor %}</div>
                <div class="lk-set__m">{{ block.settings.meters }}</div>
                <div class="lk-set__name">{{ block.settings.title }}</div>
                <div class="lk-set__text">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <ul class="lk-specs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'item' -%}
              <li {{ block.shopify_attributes }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                <span><strong>{{ block.settings.title }}</strong> {{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LK Co w zestawie",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (strona główna)" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Co dostajesz" },
    { "type": "text", "id": "subheading", "label": "Podtytuł", "default": "Każda girlanda ma 1,5 m. Wybierz, ile metrów potrzebujesz." },
    { "type": "image_picker", "id": "image", "label": "Zdjęcie (telefon)" },
    { "type": "image_picker", "id": "image_desktop", "label": "Zdjęcie (komputer)" },
    { "type": "number", "id": "media_index", "label": "Zdjęcie produktu nr (bez obrazu)", "default": 3 }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Zestaw",
      "settings": [
        { "type": "text", "id": "title", "label": "Nazwa", "default": "Zestaw" },
        { "type": "range", "id": "count", "label": "Liczba girland", "min": 1, "max": 8, "step": 1, "default": 2 },
        { "type": "text", "id": "meters", "label": "Długość razem", "default": "3 m" },
        { "type": "text", "id": "text", "label": "Opis", "default": "Opis" }
      ]
    },
    {
      "type": "item",
      "name": "Cecha",
      "settings": [
        { "type": "text", "id": "title", "label": "Tytuł", "default": "Pozycja" },
        { "type": "text", "id": "text", "label": "Opis", "default": "Opis" }
      ]
    }
  ]
}
{% endschema %}
